; Engine configuration file.
; Godot 4 port — тактический шутер «VALORANT: ЛОКАЛКА».
; Веб-версия живёт в корне репозитория и неприкосновенна.

config_version=5

[application]

config/name="Valorant Lokalka (Godot)"
run/main_scene="res://scenes/ui/lobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Net="*res://src/net/net.gd"
Fx="*res://src/agents/fx.gd"
Smokes="*res://src/agents/effects/smoke_world.gd"
Ears="*res://src/audio/ears.gd"
Quality="*res://src/core/quality.gd"
Ui="*res://src/ui/ui_boot.gd"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

